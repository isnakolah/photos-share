# /srv/deploy/photos/.env  (chmod 600)

# ----- Immich -----
IMMICH_VERSION=v3.2.4
UPLOAD_LOCATION=/mnt/nas/data/photos/immich
DB_DATA_LOCATION=/srv/data/volumes/photos-immich-postgres
# A-Za-z0-9 only
DB_PASSWORD=change-me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# ----- photos-share -----
PUBLIC_BASE_URL=https://photos.nomonlab.com
# Where "open in Immich" links on the admin page point
IMMICH_PUBLIC_URL=http://192.168.100.75:2283
# API key of the album owner (Immich > Account Settings > API Keys) with:
# asset.upload asset.read asset.update asset.delete album.read albumAsset.create
# sharedLink.read tag.create tag.asset
IMMICH_API_KEY=
# Shown as "Added by <name>" on photos you add yourself
OWNER_NAME=Daniel
# Basic-auth password for the admin page on :3101 (any username)
ADMIN_PASSWORD=change-me
SHARE_DATA_LOCATION=/srv/data/volumes/photos-share

# ----- LAN fast lane -----
LAN_IP=192.168.100.75
# Cloudflare token with Zone DNS Edit on nomonlab.com (for the LAN certificate)
CF_DNS_API_TOKEN=

# ----- Momento (album designer) -----
MOMENTO_INTERNAL_URL=http://momento-api:5110
# Same value as MOMENTO_SERVICE_KEY in /srv/deploy/momento/.env
MOMENTO_SERVICE_KEY=
MOMENTO_OWNER_EMAIL=
